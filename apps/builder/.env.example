# Sociarena Builder - Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to git

# ===========================================
# DOCKER / POSTGRESQL
# Used by docker-compose.yml
# ===========================================
# Generate with: openssl rand -base64 48
DB_PASSWORD=

# ===========================================
# DATABASE (Application)
# ===========================================
DATABASE_URL="postgresql://webstudio:password@localhost:5432/webstudio"
DIRECT_URL="postgresql://webstudio:password@localhost:5432/webstudio"

# ===========================================
# AUTHENTICATION SECRETS
# Generate with: openssl rand -hex 32
# ===========================================
AUTH_SECRET=

# ===========================================
# OIDC (Infomaniak)
# ===========================================
OIDC_ISSUER=https://login.infomaniak.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# Development redirect URI: https://vite.wstd.dev:5173/auth/infomaniak/callback
# Production redirect URI: https://builder.sociarena.com/auth/infomaniak/callback
OIDC_REDIRECT_URI=https://your-domain.com/auth/infomaniak/callback
OIDC_SCOPES='openid profile email'

# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=development
DEV_LOGIN=false

# PostgREST
POSTGREST_URL=http://localhost:3001

# Generate with: openssl rand -base64 48
PGRST_JWT_SECRET=
POSTGREST_API_KEY=
# 1. Go on https://jwt.io
# 2. In payload text box, enter:
# {
#   "role": "webstudio"
# }
# 3. In "Verify Signature", enter the PGRST_JWT_SECRET value
# 4. Copy the generated token (the encoded string on the left)

# Features
FEATURES=*
USER_PLAN=pro
MAX_ASSETS_PER_PROJECT=50
